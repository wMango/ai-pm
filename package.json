{
  "name": "ai-pm-engine",
  "version": "1.0.0",
  "description": "AI 时代图形化项目管理：pm.yaml 计算引擎",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "pretest": "npm run -s build:plugin",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "export-demo": "tsx scripts/export-demo.ts",
    "pm": "tsx src/cli.ts",
    "demo:dashboard": "tsx src/cli.ts dashboard --dir examples/kb-demo/.pm --now 2026-10-26T09:00:00Z && tsx src/cli.ts dashboard --dir examples/kb-demo/.pm --now 2026-10-26T09:00:00Z --out docs/assets/demo-dashboard.html",
    "build:plugin": "tsx scripts/build-plugin.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "private": true
}
